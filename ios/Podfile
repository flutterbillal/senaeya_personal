
# Global iOS deployment target
platform :ios, '16.0'

# Disable CocoaPods analytics
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(
    File.join('..', 'Flutter', 'Generated.xcconfig'),
    __FILE__
  )

  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. Run flutter pub get first."
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end

  raise "FLUTTER_ROOT not found. Try running flutter pub get again."
end

require File.expand_path(
  File.join('packages', 'flutter_tools', 'bin', 'podhelper'),
  flutter_root
)

flutter_ios_podfile_setup

# Runner target
target 'Runner' do
  use_frameworks!
  use_modular_headers!

  # Flutter plugins
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # Firebase dependencies
  pod 'Firebase/Core'
  pod 'Firebase/Messaging'

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# Post install configurations
post_install do |installer|

  installer.pods_project.targets.each do |target|

    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|

      # Minimum iOS deployment target
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'

      # Excluded architectures
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'i386'

      # Permission configurations
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
        'PERMISSION_PHOTOS=1',
        'PERMISSION_LOCATION=1',
        'PERMISSION_MEDIA_LIBRARY=0',
        'PERMISSION_MICROPHONE=0',
      ]

    end
  end

  # Update CocoaPods xcconfig files
  Dir.glob(
    File.join(__dir__, 'Pods', 'Target Support Files', '**', '*.xcconfig')
  ).each do |path|

    text = File.read(path)

    updated = text
      .gsub(
        'EXCLUDED_ARCHS[sdk=iphonesimulator*] = arm64',
        'EXCLUDED_ARCHS[sdk=iphonesimulator*] = i386'
      )
      .gsub(
        'EXCLUDED_ARCHS[sdk=iphonesimulator*]=i386 arm64',
        'EXCLUDED_ARCHS[sdk=iphonesimulator*]=i386'
      )

    File.write(path, updated) if updated != text

  end
end
